# Copy to .env.local and fill in real values.
# These are all client-side/public values (Vite inlines VITE_* into the bundle).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# GA4 Measurement ID (Firebase Console → Analytics). Optional: analytics stays
# off when blank. The SDK also needs the project to have Analytics enabled.
VITE_FIREBASE_MEASUREMENT_ID=
VITE_RECAPTCHA_ENTERPRISE_KEY=
# Model-catalog Cloud Function endpoint (src/lib/models.ts).
VITE_AI_MODELS_URL=
# Local dev only. Leave blank in prod.
VITE_APPCHECK_DEBUG_TOKEN=
